      "entityType": "uniques"
    },
    {
      "value": "(\"provider\" = 'GOOGLE' AND \"provider_account_id\" IS NOT NULL AND \"password_hash\" IS NULL)\n       OR (\"provider\" = 'PASSWORD' AND \"provider_account_id\" IS NULL AND \"password_hash\" IS NOT NULL)",
      "name": "chk_auth_credentials",
      "entityType": "checks",
      "schema": "public",
      "table": "authentications"
    },
    {
      "value": "btrim(\"media_external_id\") <> ''",
      "name": "chk_media_media_external_id_not_blank",
      "entityType": "checks",
      "schema": "public",
      "table": "media"
    },
    {
      "value": "btrim(\"title\") <> ''",
      "name": "chk_media_title_not_blank",
      "entityType": "checks",
      "schema": "public",
      "table": "media"
    },
    {
      "value": "btrim(\"name\") <> ''",
      "name": "chk_people_name_not_blank",
      "entityType": "checks",
      "schema": "public",
      "table": "people"
    },
    {
      "value": "\"user_id\" IS NULL OR \"user_id\" <> \"owner_user_id\"",
      "name": "chk_people_not_owner",
      "entityType": "checks",
      "schema": "public",
      "table": "people"
    },
    {
      "value": "\"current_season\" IS NULL OR \"current_season\" >= 1",
      "name": "chk_shared_media_season",
      "entityType": "checks",
      "schema": "public",
      "table": "shared_media"
    },
    {
      "value": "\"current_episode\" IS NULL OR \"current_episode\" >= 1",
      "name": "chk_shared_media_episode",
      "entityType": "checks",
      "schema": "public",
      "table": "shared_media"
    },
    {
      "value": "\"current_episode\" IS NULL OR \"current_season\" IS NOT NULL",
      "name": "chk_shared_media_episode_requires_season",
      "entityType": "checks",
      "schema": "public",
      "table": "shared_media"
    },
    {
      "value": "\"type\" = 'TV_SHOW' OR (\"current_season\" IS NULL AND \"current_episode\" IS NULL)",
      "name": "chk_shared_media_movie_progress",
      "entityType": "checks",
      "schema": "public",
      "table": "shared_media"
    },
    {
      "value": "\"rating\" IS NULL OR \"rating\" BETWEEN 1 AND 5",
      "name": "chk_user_media_rating",
      "entityType": "checks",
      "schema": "public",
      "table": "user_media"
    },
    {
      "value": "\"current_season\" IS NULL OR \"current_season\" >= 1",
      "name": "chk_user_media_season",
      "entityType": "checks",
      "schema": "public",
      "table": "user_media"
    },
    {
      "value": "\"current_episode\" IS NULL OR \"current_episode\" >= 1",
      "name": "chk_user_media_episode",
      "entityType": "checks",
      "schema": "public",
      "table": "user_media"
    },
    {
      "value": "\"current_episode\" IS NULL OR \"current_season\" IS NOT NULL",
      "name": "chk_user_media_episode_requires_season",
